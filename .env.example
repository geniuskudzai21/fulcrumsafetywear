# Public Supabase project settings (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical site URL used by metadata, sitemap, robots and auth redirects.
# The app's auth callback is ${NEXT_PUBLIC_SITE_URL}/auth/callback.
# Production: https://fulcrumindustrial.co.zw
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Add these callback URLs in Supabase Dashboard > Authentication > URL
# Configuration (Site URL + Redirect URLs), and add the Supabase callback to
# Google Cloud (see README):
#   http://localhost:3000/auth/callback
#   https://fulcrumindustrial.co.zw/auth/callback

# Server-only. Never prefix this with NEXT_PUBLIC_ and never import it into
# client components. It bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only Paynow credentials. Never prefix these with NEXT_PUBLIC_.
# In development use your Paynow test integration and test mobile numbers
# (see the Paynow section in README.md).
PAYNOW_INTEGRATION_ID=your-paynow-integration-id
PAYNOW_INTEGRATION_KEY=your-paynow-integration-key
# Paynow posts status updates here. Must be publicly reachable over HTTPS.
PAYNOW_RESULT_URL=https://fulcrumindustrial.co.zw/api/paynow/webhook
# The customer is redirected here after paying. The app appends ?payment=<id>.
PAYNOW_RETURN_URL=https://fulcrumindustrial.co.zw/checkout/return
# Optional. While testing, set this to your Paynow merchant login email.
# Paynow test mode requires authemail to match the merchant account.
# Remove it (or set a real support address) before going live.
PAYNOW_AUTH_EMAIL=
